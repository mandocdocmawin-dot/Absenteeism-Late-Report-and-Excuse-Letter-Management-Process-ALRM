# Server-only values. Never add a VITE_ prefix to the cookie secret.
ALRM_BACKEND_ORIGIN=https://absenteeism-late-report-and-excuse.onrender.com
# Set a persistent random secret of at least 32 characters in Vercel before deploying.
# Local npm run dev uses a process-local secret if this is omitted.
ALRM_COOKIE_SECRET=
