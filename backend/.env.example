APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

ACADEMIC_CURRENT_SEMESTER=1st
ACADEMIC_CURRENT_SCHOOL_YEAR=2026-2027

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Public HTTPS logo URL; must be reachable by email clients without signing in.
MAIL_LOGO_URL="https://absenteeism-late-report-and-excuse.onrender.com/images/mail/lv-logo.png"
OTP_QUEUE_CONNECTION=database
BREVO_TIMEOUT=20
BREVO_MAX_DURATION=25
# Leave empty to notify the instructor assigned to each request's class.
MAIL_INSTRUCTOR_ALLOWLIST=
# Optional: redirect only instructor request emails; leave empty for normal delivery.
MAIL_INSTRUCTOR_TEST_RECIPIENT=
MAIL_PROGRAM_HEAD_TEST_RECIPIENT=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# qpdf 11+ is required for PDF evidence validation (included in Docker).
QPDF_BINARY=qpdf
